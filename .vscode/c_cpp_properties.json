{
    "configurations": [
        {
            "name": "Win64 - Unreal Engine 5.4",
            "intelliSenseMode": "windows-msvc-x64",
            "cppStandard": "c++20",

            // --- Engine Include Paths ---
            // Adjust the UE root path if your engine is installed elsewhere.
            // Common locations:
            //   Epic Games Launcher install: C:\Program Files\Epic Games\UE_5.4
            //   Source build:                D:\UnrealEngine\UE_5.4
            "includePath": [
                "${workspaceFolder}/**",
                "C:/Program Files/Epic Games/UE_5.4/Engine/Source/**",
                "C:/Program Files/Epic Games/UE_5.4/Engine/Source/Runtime/**",
                "C:/Program Files/Epic Games/UE_5.4/Engine/Source/Developer/**",
                "C:/Program Files/Epic Games/UE_5.4/Engine/Source/Editor/**",
                "C:/Program Files/Epic Games/UE_5.4/Engine/Plugins/**",
                "${default}"
            ],

            // --- Compiler Path ---
            // Update this to match your MSVC installation year.
            "compilerPath": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.40.33807/bin/Hostx64/x64/cl.exe",

            // --- Unreal Engine Preprocessor Defines ---
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "WIN32",
                "_WIN64",
                "UE_BUILD_DEVELOPMENT=1",
                "WITH_EDITOR=1",
                "WITH_ENGINE=1",
                "WITH_UNREAL_DEVELOPER_TOOLS=1",
                "IS_PROGRAM=0",
                "UE_GAME=0",
                "UE_EDITOR=1"
            ],

            // VS Code response file (generated by UBT when you generate project files)
            "compileCommands": "${workspaceFolder}/Intermediate/Build/Win64/UnrealEditor/Development/compile_commands.json"
        }
    ],
    "version": 4
}
