{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Development Editor)",
            "type": "shell",
            "command": "D:/GMS/UE_5.8/Engine/Build/BatchFiles/Build.bat",
            "args": [
                "SURFKINIEditor",
                "Win64",
                "Development",
                "${workspaceFolder}/SURFKINI.uproject",
                "-waitmutex"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build (Shipping)",
            "type": "shell",
            "command": "D:/GMS/UE_5.8/Engine/Build/BatchFiles/Build.bat",
            "args": [
                "SURFKINI",
                "Win64",
                "Shipping",
                "${workspaceFolder}/SURFKINI.uproject",
                "-waitmutex"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Generate Project Files",
            "type": "shell",
            "command": "D:/GMS/UE_5.8/Engine/Build/BatchFiles/GenerateProjectFiles.bat",
            "args": [
                "${workspaceFolder}/SURFKINI.uproject",
                "-Game",
                "-VSCode"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Clean (Development Editor)",
            "type": "shell",
            "command": "D:/GMS/UE_5.8/Engine/Build/BatchFiles/Build.bat",
            "args": [
                "SURFKINIEditor",
                "Win64",
                "Development",
                "${workspaceFolder}/SURFKINI.uproject",
                "-clean"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Start FCC AI Server",
            "type": "shell",
            "command": "${workspaceFolder}/fcc-server.bat",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Unreal Editor",
            "type": "shell",
            "command": "D:/GMS/UE_5.8/Engine/Binaries/Win64/UnrealEditor.exe",
            "args": [
                "${workspaceFolder}/SURFKINI.uproject"
            ],
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
